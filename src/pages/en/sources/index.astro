---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('sources');
const sorted = all.sort((a, b) => a.data.source_id.localeCompare(b.data.source_id));
---

<Layout title="Sources" lang={lang} description="Sources for CREDO The Inquiry.">
  <h1>Sources</h1>
  <p>
    All sources cited in this inquiry: original quotations, translations, and verification status. No
    doctrines or quotations are invented.
  </p>

  <ul style="list-style: none; padding-left: 0;" class="reveal-stagger">
    {
      sorted.map((src) => (
        <li class="source-item">
          <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--color-ink-faint); margin-bottom: 4px;">
            {src.data.source_id} ·{' '}
            <span
              class={`verif ${src.data.verification_status === 'PARTIALLY VERIFIED' ? 'PARTIALLY' : src.data.verification_status}`}
            >
              {src.data.verification_status}
            </span>
          </div>
          <h3>
            <a href={`${base}/en/sources/${src.data.source_id}`}>{src.data.title}</a>
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-soft); margin: 0;">
            {src.data.author} · {src.data.date} · {src.data.source_type}
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
