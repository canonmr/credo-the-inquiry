---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('argument-nodes', ({ data }) => (data.language ?? 'en') !== 'id');
const sorted = all.sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<Layout title="Arguments" lang={lang} description="Argument steps for CREDO The Inquiry.">
  <h1>Arguments</h1>
  <p>
    The first two chapters use 24 argument steps: 15 steps for the problem of evil (POE-001 through POE-015)
    and 9 steps for the question of revelation (REV-001 through REV-009). Each step contains a claim,
    premises, an inference, a conclusion, the strongest objection, and what this argument does not establish.
  </p>

  <ul style="list-style: none; padding-left: 0;" class="reveal-stagger">
    {
      sorted.map((node) => (
        <li class="node-item">
          <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--color-ink-faint); margin-bottom: 4px;">
            {node.data.id} · L{node.data.layer} ·{' '}
            <span class={`status ${node.data.inference_status}`}>
              {node.data.inference_status.replace(/_/g, ' ')}
            </span>
          </div>
          <h3>
            <a href={`${base}/en/nodes/${node.data.id}`}>{node.data.title}</a>
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-soft); margin: 0;">
            {node.data.claim_type} · {node.data.domain}
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
