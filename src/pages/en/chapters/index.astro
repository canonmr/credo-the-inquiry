---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const chapters = (await getCollection('chapters', ({ data }) => data.language === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Chapters" lang={lang} description="List of chapters in CREDO The Inquiry.">
  <h1>Chapters</h1>
  <p>
    Each chapter pursues one large question, step by step — with argument nodes, verified sources, and an
    honest record of what remains unanswered.
  </p>

  <ul style="list-style: none; padding-left: 0;" class="reveal-stagger">
    {
      chapters.map((c) => (
        <li class="node-item">
          <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--color-ink-faint); margin-bottom: 4px;">
            Chapter {c.data.order} · {c.data.nodes_used.length} steps · {c.data.sources_used.length} sources
          </div>
          <h3>
            <a href={`${base}/en/chapters/${c.data.chapter_slug}`}>{c.data.title}</a>
          </h3>
        </li>
      ))
    }
  </ul>
</Layout>
