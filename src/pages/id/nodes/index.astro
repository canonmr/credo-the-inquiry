---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'id' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('argument-nodes', ({ data }) => (data.language ?? 'en') === 'id');
const sorted = all.sort((a, b) => a.data.id.localeCompare(b.data.id));

const statusLabel = (s: string): string =>
  ({
    VALID: 'Sah',
    INVALID: 'Tidak sah',
    CONTESTED: 'Diperdebatkan',
    REQUIRES_ADDITIONAL_PREMISE: 'Perlu alasan tambahan',
    UNDERDETERMINED: 'Belum dapat ditentukan',
  })[s] ?? s;

const typeLabel = (t: string): string =>
  ({
    TEXTUAL: 'Kutipan teks',
    HISTORICAL: 'Sejarah',
    EMPIRICAL: 'Fakta',
    LOGICAL: 'Logika',
    PHILOSOPHICAL: 'Filsafat',
    THEOLOGICAL: 'Teologi',
    INTERPRETIVE: 'Penafsiran',
    COMPOSITE: 'Gabungan',
  })[t] ?? t;

const domainLabel = (d: string): string =>
  d
    .split(';')
    .map(
      (x) =>
        (
          ({
            Philosophy: 'Filsafat',
            'Philosophy of Religion': 'Filsafat Agama',
            'Christian Theology': 'Teologi Kristen',
            'Catholic Theology': 'Teologi Katolik',
            'Biblical Studies': 'Studi Alkitab',
            History: 'Sejarah',
            Ecclesiology: 'Gereja',
            Patristics: 'Bapa Gereja',
            Apologetics: 'Apologetika',
          }) as Record<string, string>
        )[x.trim()] ?? x.trim()
    )
    .join('; ');
---

<Layout title="Argumen" lang={lang} description="Langkah-langkah argumen CREDO The Inquiry.">
  <h1>Argumen</h1>
  <p>
    Lima bab pertama memakai 51 langkah argumen: 15 langkah untuk masalah kejahatan (POE-001 hingga POE-015),
    9 langkah untuk pertanyaan wahyu (REV-001 hingga REV-009), 9 langkah untuk pertanyaan Kitab Suci (SCR-001
    hingga SCR-009), 9 langkah untuk pertanyaan otoritas (AUT-001 hingga AUT-009), dan 9 langkah untuk klaim
    gereja tentang pendirinya (CHR-001 hingga CHR-009). Setiap langkah memuat pernyataan inti,
    alasan-alasannya, kesimpulan, keberatan terkuat, dan batasan pembuktiannya.
  </p>

  <ul style="list-style: none; padding-left: 0;" class="reveal-stagger">
    {
      sorted.map((node) => (
        <li class="node-item">
          <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--color-ink-faint); margin-bottom: 4px;">
            {node.data.id} · L{node.data.layer} ·{' '}
            <span class={`status ${node.data.inference_status}`}>
              {statusLabel(node.data.inference_status)}
            </span>
          </div>
          <h3>
            <a href={`${base}/id/nodes/${node.data.id}`}>{node.data.title}</a>
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-soft); margin: 0;">
            {typeLabel(node.data.claim_type)} · {domainLabel(node.data.domain)}
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
