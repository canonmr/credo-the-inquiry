---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'id' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('sources');
const sorted = all.sort((a, b) => a.data.source_id.localeCompare(b.data.source_id));

const verifLabel = (v: string): string =>
  ({
    VERIFIED: 'Terverifikasi',
    'PARTIALLY VERIFIED': 'Sebagian terverifikasi',
    UNVERIFIED: 'Belum diverifikasi',
    DISPUTED: 'Diperdebatkan',
  })[v] ?? v;

const typeLabel = (t: string): string =>
  ({
    'primary-philosophical': 'Karya filsafat',
    'primary-theological': 'Karya teologi',
    'church-document': 'Dokumen gereja',
    'biblical-text': 'Teks Alkitab',
    patristic: 'Bapa Gereja',
    historical: 'Sejarah',
    'scholarly-secondary': 'Kajian akademik',
    reference: 'Rujukan umum',
  })[t] ?? t;
---

<Layout title="Sumber" lang={lang} description="Sumber-sumber CREDO The Inquiry.">
  <h1>Sumber</h1>
  <p>
    Seluruh sumber yang dirujuk dalam inkuiri ini: kutipan asli, terjemahan, dan status verifikasi. Tidak ada
    doktrin atau kutipan yang dikarang.
  </p>

  <ul style="list-style: none; padding-left: 0;" class="reveal-stagger">
    {
      sorted.map((src) => (
        <li class="source-item">
          <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--color-ink-faint); margin-bottom: 4px;">
            {src.data.source_id} ·{' '}
            <span
              class={`verif ${src.data.verification_status === 'PARTIALLY VERIFIED' ? 'PARTIALLY' : src.data.verification_status}`}
            >
              {verifLabel(src.data.verification_status)}
            </span>
          </div>
          <h3>
            <a href={`${base}/id/sources/${src.data.source_id}`}>{src.data.title}</a>
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-soft); margin: 0;">
            {src.data.author} · {src.data.date} · {typeLabel(src.data.source_type)}
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
