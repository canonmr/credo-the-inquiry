---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'id' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const chapters = (await getCollection('chapters', ({ data }) => data.language === 'id')).sort(
  (a, b) => a.data.order - b.data.order
);
const nodes = await getCollection('argument-nodes');
const sources = await getCollection('sources');
---

<Layout
  title="Beranda"
  lang={lang}
  description="CREDO The Inquiry — Inkuiri iman dan akal budi yang terstruktur, dari pertanyaan mendasar hingga kesimpulan teologis."
>
  <h1>CREDO The Inquiry</h1>
  <p
    style="font-family: var(--font-sans); color: var(--color-ink-soft); font-size: var(--fs-small); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 var(--gap-2) 0;"
  >
    Iman dan akal budi dalam satu rangkaian penalaran
  </p>

  <p>
    Sebuah inkuiri terstruktur: dari masalah kejahatan hingga klaim gereja, setiap langkah diuji secara logis
    dan dirujuk kepada sumbernya. Tanpa slogan. Tanpa scoring. Hanya argumen yang bisa Anda verifikasi
    sendiri.
  </p>

  <p>
    Bab pertama memaparkan 15 langkah penalaran tentang pengetahuan Allah, kebebasan manusia, dan keberadaan
    kejahatan. Setiap langkah memuat pernyataan, alasan, kesimpulan, serta keberatan terkuat — beserta status
    epistemiknya.
  </p>

  <h2>Mulai dari sini</h2>
  <ul class="reveal-stagger">
    {
      chapters.map((c) => (
        <li>
          <strong>Bab {c.data.order}:</strong>{' '}
          <a href={`${base}/id/chapters/${c.data.chapter_slug}`}>{c.data.title_id || c.data.title}</a>
          <div style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-faint);">
            {c.data.nodes_used.length} langkah · {c.data.sources_used.length} sumber
          </div>
        </li>
      ))
    }
  </ul>

  <h2>Struktur situs ini</h2>
  <ul class="reveal-stagger">
    <li><a href={`${base}/id/nodes`}>{nodes.length} langkah argumen</a> (POE-001 hingga POE-015)</li>
    <li>
      <a href={`${base}/id/sources`}>{sources.length} sumber</a> — Kitab Suci, karya teologi, dokumen gereja, kajian
      akademik
    </li>
  </ul>

  <h2>Prinsip penalaran</h2>
  <ol>
    <li>Tidak ada kutipan, sumber, nomor halaman, atau ajaran Katolik yang dikarang-karang.</li>
    <li>Apa yang dikatakan sebuah teks dipisahkan dari apa yang diyakini sebagai kebenaran.</li>
    <li>Kesimpulan tidak boleh melampaui alasan-alasannya.</li>
    <li>
      Pengetahuan akan masa depan, sebab-akibat, izin, niat, kemungkinan, kewajaran, pembelaan, dan teodisi
      tetap dibedakan.
    </li>
    <li>Pembelaan kehendak bebas Plantinga disajikan sebagai pembelaan, bukan sebagai jawaban tuntas.</li>
    <li>Malaikat yang jatuh tidak dipakai untuk menjelaskan bencana alam tertentu.</li>
    <li>Tidak setiap kejahatan alamiah dihubungkan dengan dosa tertentu.</li>
    <li>Katolisisme tidak dinyatakan terbukti sebelum argumen yang relevan dikembangkan.</li>
    <li>Tidak ada skor angka untuk pandangan dunia mana pun.</li>
  </ol>
</Layout>
