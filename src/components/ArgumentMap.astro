---
/*
  ArgumentMap.astro
  Inline-SVG visualization of an argument node cluster, grouped by layer.
  Prop-driven: each chapter supplies its own node layout + edges.
  No D3. No animation. Honors prefers-reduced-motion via global CSS.
  Mobile: shows nodes, layer bands, and the dominant inter-layer edges.
  Desktop: same, scaled up; legend visible.
*/
export interface Props {
  lang: 'id' | 'en';
  nodes: Record<string, [number, number, 1 | 2 | 3]>;
  edges: Array<[string, string, string]>;
  title: string;
  intro: string;
  legend: [string, string, string];
  layerLabels: [string, string, string];
  ariaLabel: string;
}

const p = Astro.props as Props;
const isId = p.lang === 'id';

const W = 720;
const H = 440;

const layerColor: Record<1 | 2 | 3, string> = {
  1: '#6b3f2b',
  2: '#2f5d50',
  3: '#8a5a00',
};

function findNodeXY(id: string): [number, number] {
  const n = p.nodes[id];
  if (!n) return [0, 0];
  return [n[0], n[1]];
}

const nodesHref = (id: string) =>
  import.meta.env.BASE_URL.replace(/\/$/, '') + (isId ? `/id/nodes/${id}` : `/en/nodes/${id}`);
---

<section class="argument-map" aria-labelledby="map-heading">
  <h3 id="map-heading">{p.title}</h3>
  <div class="legend" aria-hidden="true">
    <span class="l1">{p.legend[0]}</span>
    <span class="l2">{p.legend[1]}</span>
    <span class="l3">{p.legend[2]}</span>
  </div>
  <p
    style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--color-ink-soft); margin: 0 0 var(--gap-2) 0;"
  >
    {p.intro}
  </p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={p.ariaLabel}>
    {/* Layer bands */}
    <rect x="0" y="20" width={W} height="100" fill="rgba(107, 63, 43, 0.05)"></rect>
    <rect x="0" y="170" width={W} height="100" fill="rgba(47, 93, 80, 0.05)"></rect>
    <rect x="0" y="320" width={W} height="100" fill="rgba(138, 90, 0, 0.05)"></rect>

    {/* Layer labels */}
    <text x="10" y="35" font-family="var(--font-sans)" font-size="11" fill="var(--color-ink-soft)">L1</text>
    <text x="10" y="185" font-family="var(--font-sans)" font-size="11" fill="var(--color-ink-soft)">L2</text>
    <text x="10" y="335" font-family="var(--font-sans)" font-size="11" fill="var(--color-ink-soft)">L3</text>

    {/* Edges */}
    {
      p.edges.map(([from, to, label]) => {
        const [x1, y1] = findNodeXY(from);
        const [x2, y2] = findNodeXY(to);
        const midX = (x1 + x2) / 2;
        const midY = (y1 + y2) / 2;
        return (
          <g>
            <path class="edge" d={`M ${x1} ${y1} Q ${midX} ${midY} ${x2} ${y2}`} />
            <text class="edge-label" x={midX + 4} y={midY - 2}>
              {label}
            </text>
          </g>
        );
      })
    }

    {/* Nodes */}
    {
      Object.entries(p.nodes).map(([id, [x, y, layer]]) => (
        <a href={nodesHref(id)}>
          <g class={`node l${layer}`}>
            <circle cx={x} cy={y} r="22" fill={layerColor[layer]} />
            <text
              x={x}
              y={y + 4}
              text-anchor="middle"
              fill="white"
              font-family="var(--font-sans)"
              font-size="9"
            >
              {id.replace(/^[A-Z]+-/, '')}
            </text>
          </g>
        </a>
      ))
    }
  </svg>
</section>
